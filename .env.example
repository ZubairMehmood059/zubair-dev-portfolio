# ==============================================================================
# Zubair Developer Portfolio & Admin CMS - Environment Variables Template
# Copy this file to .env for local development or set in your production hosting platform.
# DO NOT commit real secrets, private keys, or API tokens to source control.
# ==============================================================================

# Application Base URL
# Used for canonical metadata, OpenGraph tags, and preview links
VITE_APP_URL="http://localhost:3000"

# Admin Authentication & Security
# Default demo fallback password for Admin CMS portal is "zubair2026"
VITE_ADMIN_DEFAULT_PASSWORD="zubair2026"

# Contact Form Integration (Optional)
# If provided, submitted messages will POST to this webhook/API (e.g. Formspree, Resend, or custom backend)
# If left blank, contact submissions are stored directly in the persistent local CMS message inbox.
VITE_CONTACT_API_ENDPOINT=""
VITE_CONTACT_RECEIVER_EMAIL="itszayn1379@gmail.com"

# Optional Firebase Configuration (for cloud Firestore / Firebase Auth migration)
# Only required if connecting to a cloud Firebase backend instead of browser persistence
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional Analytics & Telemetry
VITE_ANALYTICS_ID=""

